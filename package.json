{
  "name": "nova-react",
  "version": "1.4.0",
  "description": "A modular React UI component library — import only what you need.",
  "author": "Mohammad Sarmast <mohammadsarmast1379@gmail.com>",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./autocomplete": {
      "import": "./dist/autocomplete/index.js",
      "require": "./dist/autocomplete/index.cjs"
    },
    "./autocomplete/styles.css": "./dist/autocomplete/index.css",
    "./button": {
      "import": "./dist/button/index.js",
      "require": "./dist/button/index.cjs"
    },
    "./button/styles.css": "./dist/button/index.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "demo": "vite demo",
    "demo:build": "vite build demo",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^29.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^6.0.3",
    "vite": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "react",
    "nova-react",
    "ui",
    "components",
    "autocomplete",
    "typeahead",
    "button"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mohammadsarmast/nova-react.git"
  },
  "homepage": "https://github.com/mohammadsarmast/nova-react#readme",
  "bugs": {
    "url": "https://github.com/mohammadsarmast/nova-react/issues"
  },
  "sideEffects": [
    "**/*.css"
  ]
}
