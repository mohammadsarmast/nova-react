{
  "name": "nova-react",
  "version": "1.8.1",
  "description": "A modular React UI component library — import only what you need.",
  "author": "Mohammad Sarmast <mohammadsarmast1379@gmail.com>",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./autocomplete": {
      "import": "./dist/autocomplete/index.js",
      "require": "./dist/autocomplete/index.cjs"
    },
    "./autocomplete/styles.css": "./dist/autocomplete/index.css",
    "./button": {
      "import": "./dist/button/index.js",
      "require": "./dist/button/index.cjs"
    },
    "./button/styles.css": "./dist/button/index.css",
    "./chart": {
      "import": "./dist/chart/index.js",
      "require": "./dist/chart/index.cjs"
    },
    "./chart/styles.css": "./dist/chart/index.css",
    "./datatable": {
      "import": "./dist/datatable/index.js",
      "require": "./dist/datatable/index.cjs"
    },
    "./datatable/styles.css": "./dist/datatable/index.css",
    "./workspace": {
      "import": "./dist/workspace/index.js",
      "require": "./dist/workspace/index.cjs"
    },
    "./workspace/styles.css": "./dist/workspace/index.css",
    "./calendar": {
      "import": "./dist/calendar/index.js",
      "require": "./dist/calendar/index.cjs"
    },
    "./calendar/styles.css": "./dist/calendar/index.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "demo": "vite",
    "demo:build": "vite build --mode production",
    "demo:preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0",
    "chart.js": ">=4.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^4.3.4",
    "chart.js": "^4.5.1",
    "jsdom": "^29.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^6.0.3",
    "vite": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "react",
    "nova-react",
    "ui",
    "components",
    "autocomplete",
    "typeahead",
    "button",
    "chart",
    "datatable",
    "data-table",
    "workspace",
    "desktop",
    "selection",
    "drag",
    "calendar",
    "datepicker",
    "jalali",
    "hijri",
    "persian",
    "chartjs"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mohammadsarmast/nova-react.git"
  },
  "homepage": "https://mohammadsarmast.github.io/nova-react/",
  "bugs": {
    "url": "https://github.com/mohammadsarmast/nova-react/issues"
  },
  "sideEffects": [
    "**/*.css"
  ]
}
